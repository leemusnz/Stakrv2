{
  "name": "stakr-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "preact": "^10.29.0",
    "cookie": "^0.7.2",
    "esbuild": "^0.25.8",
    "@smithy/config-resolver": "^4.4.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "lint": "next lint",
    "start": "next start",
    "test": "jest",
    "test:all": "node scripts/run-tests.js",
    "test:components": "jest --testPathPattern=\"components|app\" --testEnvironment=jsdom",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:points": "playwright test tests/e2e/points/",
    "test:e2e:cash": "playwright test tests/e2e/cash/",
    "test:e2e:integration": "playwright test tests/e2e/integration/",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "jest --testPathPattern=\"integration|api-endpoints|auth|avatar-system|challenge-system\"",
    "test:report": "jest --coverage --json --outputFile=test-reports/coverage.json",
    "test:unit": "jest --testPathPattern=\"unit|utils|helpers\"",
    "test:watch": "jest --watch",
    "test:mobile": "node scripts/mobile-test.js",
    "lighthouse:mobile": "lighthouse https://stakr.app --preset=mobile --view",
    "lighthouse:desktop": "lighthouse https://stakr.app --preset=desktop --view",
    "type-check": "tsc --noEmit",
    "release:smoke": "node scripts/release-smoke-check.js",
    "prepare": "husky",
    "test:ci": "jest --ci"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@aws-sdk/client-rds-data": "3.1009.0",
    "@aws-sdk/client-rekognition": "3.1009.0",
    "@aws-sdk/client-s3": "3.1009.0",
    "@aws-sdk/s3-request-presigner": "3.1009.0",
    "@cloudflare/workers-types": "4.20260313.1",
    "@hookform/resolvers": "^3.9.1",
    "@jest/globals": "30.3.0",
    "@neondatabase/serverless": "1.0.2",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-email/render": "2.0.4",
    "@sentry/nextjs": "^10.48.0",
    "@testing-library/dom": "10.4.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/redis": "1.37.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "3.0.3",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "0.45.1",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.23.12",
    "input-otp": "1.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "15.5.12",
    "next-auth": "4.24.13",
    "next-themes": "0.4.6",
    "nodemailer": "8.0.2",
    "react": "^19",
    "react-day-picker": "9.14.0",
    "react-dom": "^19",
    "react-hook-form": "7.71.2",
    "react-resizable-panels": "4.7.3",
    "recharts": "3.8.0",
    "resend": "6.9.3",
    "sonner": "2.0.7",
    "stripe": "^20.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "1.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.0.3",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
